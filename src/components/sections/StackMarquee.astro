---
import { STR, HOME_STACK, SKILL_GROUPS } from '../../data/site';
import type { StackItem } from '../../data/types';

const en = STR.en;
const es = STR.es;
const base = import.meta.env.BASE_URL;
const iconUrl = (s: StackItem) =>
  s.iconPath ? `${base}${s.iconPath}` :
  s.slug ? `https://cdn.simpleicons.org/${s.slug}/black` :
  null;
// Render the marquee track twice so the loop is seamless; the second half
// is aria-hidden because it duplicates the first for animation purposes.
const tiles = [...HOME_STACK.map((s) => ({ s, hidden: false })), ...HOME_STACK.map((s) => ({ s, hidden: true }))];
---
<div class="container">
  <section id="stack" class="b-section">
    <div class="section-head">
      <div>
        <div class="eyebrow">
          <span class="num">03</span><span>/</span>
          <span data-en={en.sectionSubs.stack} data-es={es.sectionSubs.stack}>{en.sectionSubs.stack}</span>
        </div>
        <h2 class="h1" style="margin-top: 12px;">Stack</h2>
      </div>
    </div>
    <div class="stack-container">
      <div
        class="tech-marquee"
        aria-label="Technologies in use"
        data-aria-en="Technologies in use"
        data-aria-es="Tecnologías en uso"
      >
        <div class="tech-marquee-track">
          {tiles.map(({ s, hidden }) => {
            const url = iconUrl(s);
            return (
              <div class="tech-tile" aria-hidden={hidden ? 'true' : 'false'}>
                {url ? (
                  <span
                    class="stack-glyph"
                    role="img"
                    aria-label={s.label}
                    style={`-webkit-mask-image: url(${url}); mask-image: url(${url});`}
                  />
                ) : (
                  <span class="stack-glyph stack-glyph--text" role="img" aria-label={s.label}>{s.label}</span>
                )}
                <div class="name">{s.label}</div>
              </div>
            );
          })}
        </div>
      </div>
      <details class="stack-disclosure">
        <summary>
          <span
            class="disclosure-label disclosure-label--expand"
            data-en={en.stackDisclosure}
            data-es={es.stackDisclosure}
          >{en.stackDisclosure}</span>
          <span
            class="disclosure-label disclosure-label--collapse"
            data-en={en.stackCollapse}
            data-es={es.stackCollapse}
          >{en.stackCollapse}</span>
        </summary>
        <div class="skill-groups" aria-label="Full technology stack">
          {SKILL_GROUPS.map((group) => (
            <section class="skill-group">
              <h3 data-en={group.label.en} data-es={group.label.es}>{group.label.en}</h3>
              <ul>
                {group.items.map((item) => <li class="chip">{item}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </details>
    </div>
  </section>
</div>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector('.stack-disclosure')?.setAttribute('open', '');
  }
</script>

<style>
  .skill-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 36px; padding: 28px 0 8px; }
  .skill-group h3 { margin: 0 0 12px; font-size: 14px; font-weight: 600; }
  .skill-group ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  @media (max-width: 720px) { .skill-groups { grid-template-columns: 1fr; } }
</style>
