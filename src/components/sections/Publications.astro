---
import { PUBLICATIONS, STR } from '../../data/site';

const en = STR.en;
const es = STR.es;
---
<div class="container">
  <section id="publication" class="b-section">
    <div class="section-head">
      <div>
        <div class="eyebrow">
          <span class="num">05</span><span>/</span>
          <span data-en={en.sectionSubs.publication} data-es={es.sectionSubs.publication}>{en.sectionSubs.publication}</span>
        </div>
        <h2 class="h1" style="margin-top: 12px;" data-en={en.sections.publication} data-es={es.sections.publication}>{en.sections.publication}</h2>
      </div>
    </div>
    <div style="display: grid; gap: 12px; margin-top: 24px;">
      {PUBLICATIONS.map((publication) => (
        <article style="border: 1px solid var(--border); padding: 28px 32px;">
          <div class="mono" style="font-size: 11px; color: var(--warm); text-transform: uppercase; letter-spacing: 0.06em;">
            <span data-en={publication.role.en} data-es={publication.role.es}>{publication.role.en}</span>
            <span> · {publication.venue} · {publication.year}</span>
          </div>
          <h3 style="font-size: 21px; line-height: 1.35; font-weight: 500; margin: 12px 0 18px;">{publication.title}</h3>
          <a class="mono" style="font-size: 12px; color: var(--fg);" href={publication.doi} target="_blank" rel="noopener noreferrer">
            doi.org/10.1117/12.3104049 ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</div>
